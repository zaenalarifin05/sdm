{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "zaenalarifin05/sdm",
  "type": "project",
  "description": "Aplikasi Pengelolaan Sumber Daya Manusia Pabrik",
  "license": "MIT",
  "require": {"php":"^8.3","laravel/framework":"^13.17","laravel/tinker":"^3.0"},
  "require-dev": {"fakerphp/faker":"^1.23","laravel/pint":"^1.27","mockery/mockery":"^1.6","nunomaduro/collision":"^8.6","phpunit/phpunit":"^12.5.12"},
  "autoload": {"psr-4":{"App\\":"app/","Database\\Seeders\\":"database/seeders/"}},
  "autoload-dev": {"psr-4":{"Tests\\":"tests/"}},
  "scripts": {"post-autoload-dump":["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump","@php artisan package:discover --ansi"],"test":["@php artisan config:clear --ansi","@php artisan test"]},
  "config":{"optimize-autoloader":true,"preferred-install":"dist","sort-packages":true},
  "minimum-stability":"stable","prefer-stable":true
}
